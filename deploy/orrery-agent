#!/usr/bin/env bash
# Keeps one agent running inside its tmux pane: restarts `orrery run <Agent>` whenever it exits (a crash, or a fatal
# stop such as a poisoned store), with backoff, and stops cleanly on SIGTERM/SIGHUP (systemctl stop, tmux kill).
#
#   ORRERY_RESTART_DELAY  first delay in seconds (default 2); doubles up to 60
#   ORRERY_RESTART_RESET  a run at least this many seconds long resets the delay (default 300)
set -u

agent="${1:?usage: orrery-agent <Agent>}"
first_delay="${ORRERY_RESTART_DELAY:-2}"
reset_after="${ORRERY_RESTART_RESET:-300}"
delay="$first_delay"
child=""
stopping=0

stop() {
	stopping=1
	if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null; fi
}
trap stop TERM HUP
# A trap (not an ignore) so the agent itself still gets the default SIGINT behavior.
trap ':' INT

while [ "$stopping" -eq 0 ]; do
	started=$SECONDS
	# <&0 keeps the pane's terminal: a background job would otherwise read from /dev/null.
	orrery run "$agent" <&0 &
	child=$!
	# A stop that landed before $child was set had nothing to signal.
	if [ "$stopping" -eq 1 ]; then kill -TERM "$child" 2>/dev/null; fi
	wait "$child"
	code=$?
	while kill -0 "$child" 2>/dev/null; do
		wait "$child"
		code=$?
	done
	child=""
	[ "$stopping" -eq 1 ] && break
	if [ $((SECONDS - started)) -ge "$reset_after" ]; then delay="$first_delay"; fi
	echo "orrery-agent: $agent exited ($code); restarting in ${delay}s"
	sleep "$delay" &
	child=$!
	wait "$child"
	child=""
	delay=$(awk -v d="$delay" 'BEGIN { d *= 2; if (d > 60) d = 60; print d }')
done
exit 0
