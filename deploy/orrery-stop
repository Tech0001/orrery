#!/usr/bin/env bash
# systemd ExecStop for orrery@<Lane>: ask the lane to close itself (SIGTERM to the restart loop, which forwards it),
# wait up to 20 s, then remove the lane's tmux server.
set -u
lane="${1:?usage: orrery-stop <Lane>}"
export TMUX_TMPDIR="${TMUX_TMPDIR:-/var/lib/orrery/run}"
socket="orrery-$lane"
# The pane running the restart loop, wherever it is: a second window may be the current one.
pid=$(tmux -L "$socket" list-panes -s -t "$lane" -F '#{pane_pid} #{pane_start_command}' 2>/dev/null | awk '/orrery-lane/ { print $1; exit }')
if [ -n "$pid" ]; then
	kill -TERM "$pid" 2>/dev/null
	for _ in $(seq 1 100); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.2
	done
fi
tmux -L "$socket" kill-server 2>/dev/null
exit 0
