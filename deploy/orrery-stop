#!/usr/bin/env bash
# systemd ExecStop for orrery@<Name>: ask the agent to close itself (SIGTERM to the restart loop, which forwards it),
# wait up to 20 s, then remove the agent's tmux server.
set -u
agent="${1:?usage: orrery-stop <Name>}"
export TMUX_TMPDIR="${TMUX_TMPDIR:-/var/lib/orrery/run}"
socket="orrery-$agent"
# The pane running the restart loop, wherever it is: a second window may be the current one. Before 0.6.0 the loop
# was deploy/orrery-lane, and a pane started then keeps that name until it restarts.
pid=$(tmux -L "$socket" list-panes -s -t "$agent" -F '#{pane_pid} #{pane_start_command}' 2>/dev/null | awk '/orrery-(agent|lane)/ { print $1; exit }')
if [ -n "$pid" ]; then
	kill -TERM "$pid" 2>/dev/null
	for _ in $(seq 1 100); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.2
	done
fi
tmux -L "$socket" kill-server 2>/dev/null
exit 0
