#!/usr/bin/env bash
# Attach to an agent's terminal from anywhere: ssh -t orrery@<server> orrery-attach <Agent>
# Detach with Ctrl-b d; the agent keeps running.
set -eu
agent="${1:?usage: orrery-attach <Agent>}"
export TMUX_TMPDIR="${TMUX_TMPDIR:-/var/lib/orrery/run}"
exec tmux -L "orrery-$agent" attach -t "$agent"
