#!/usr/bin/env bash
# Attach to a lane's terminal from anywhere: ssh -t orrery@<server> orrery-attach <Lane>
# Detach with Ctrl-b d; the lane keeps running.
set -eu
lane="${1:?usage: orrery-attach <Lane>}"
export TMUX_TMPDIR="${TMUX_TMPDIR:-/var/lib/orrery/run}"
exec tmux -L "orrery-$lane" attach -t "$lane"
