{
  "name": "orrery",
  "version": "0.5.0",
  "private": true,
  "description": "Persistent lane memory for coding agents across sessions and models",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tech0001/orrery.git"
  },
  "type": "module",
  "bin": {
    "orrery": "./src/cli/main.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "install-local": "node --disable-warning=ExperimentalWarning scripts/install.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:bun": "ORRERY_SQLITE=bun bun scripts/bun-store-check.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "@earendil-works/pi-env": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "proper-lockfile": "4.1.2",
    "smol-toml": "1.9.0",
    "typebox": "1.3.27",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
